# Example shape for a SOPS + age encrypted local secret file.
# Replace placeholder values, encrypt with your age recipient, and keep the real encrypted file outside git if desired.
spring:
  datasource:
    password: ENC[AES256_GCM,data:replace-with-sops-ciphertext,type:str]
  data:
    redis:
      password: ENC[AES256_GCM,data:replace-with-sops-ciphertext,type:str]
sops:
  age:
    - recipient: age1exampleexampleexampleexampleexampleexampleexampleexampleexampleq4r4yr
      enc: |
        -----BEGIN AGE ENCRYPTED FILE-----
        example
        -----END AGE ENCRYPTED FILE-----
  lastmodified: "2026-07-07T00:00:00Z"
  mac: ENC[AES256_GCM,data:replace-with-sops-mac,type:str]
  encrypted_regex: "^(password|secret|token|key)$"
  version: 3.9.0
