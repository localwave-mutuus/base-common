<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>ai.mutuus.sample</groupId>
    <artifactId>sample-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>sample-api</name>
    <description>common-platform 소비 검증용 샘플 API (통합 테스트)</description>

    <properties>
        <java.version>21</java.version>
        <!-- 샘플은 사내 저장소에 게시하지 않는다 (reactor 의 ./mvnw deploy 시 제외) -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!--
      common-platform BOM import → 자사 아티팩트/노출 optional 의존성(logstash·springdoc)을
      "버전 없이" 추가할 수 있다(버전 단일 출처 · CVE 일괄 롤아웃).
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.mutuus.common</groupId>
                <artifactId>common-platform-bom</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 웹 소비 서비스: 큐레이션 스타터 1개로 common-platform + 표준 웹 스택(web/security/
             oauth2/actuator/validation/restclient/aspectj) + JSON 로깅(logstash) 전부 확보.
             (이전엔 이 자리에 그 9개를 직접 나열했다.) 버전은 BOM 관리. -->
        <dependency>
            <groupId>ai.mutuus.common</groupId>
            <artifactId>common-platform-starter-web</artifactId>
        </dependency>

        <!-- OpenAPI 3.x(3.1) 스펙 + Swagger UI. 버전은 common-platform-bom 관리. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- 영속성(BaseEntity 감사 데모): JPA + H2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 게시판 CRUD 3-스택 데모: jOOQ + Spring Data JDBC(JPA 는 위에서 이미). 버전은 Boot BOM 관리. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <!-- 스키마 버전 관리(운영급): 엔티티 자동 DDL 대신 Flyway 마이그레이션 + ddl-auto=validate.
             Boot 4 는 Flyway 자동구성을 별도 모듈로 분리(cache/restclient 처럼) → flyway-core 만으론 자동실행이
             안 되므로 spring-boot-starter-flyway(자동구성 + flyway-core 전이)를 쓴다. H2·PostgreSQL 공통 지원. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Spring Modulith: 모듈(=바운디드 컨텍스트) 경계 검증 + 모듈 간 이벤트(@ApplicationModuleListener).
             버전은 common-platform-bom 의 spring-modulith-bom 이 관리(버전 명시 없음). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!-- 모듈 간 이벤트 애노테이션(@ApplicationModuleListener). 레지스트리(아웃박스) 백엔드는 추가하지 않아
             in-process 표준 리스너로 동작(선불 데모라 아웃박스 미필요; 필요 시 -jdbc/-jpa 추가 → 260702.010). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flyway 10+ 는 DB별 지원을 모듈로 분리했다. 로컬 실 PostgreSQL(local 프로파일 + *LiveIntegrationTest)에서
             마이그레이션하려면 이 모듈이 필요(PG 17 지원). H2 는 flyway-core 내장이라 별도 모듈 불필요. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- 매핑: MapStruct(컴파일 타임 매퍼 생성). Boot BOM 미관리 → 명시 버전. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>
        <!-- H2: JPA 감사 데모(runtime) + DB 계층 데모가 org.h2.jdbcx.JdbcDataSource 를 컴파일 참조하므로 compile 스코프.
             sample-api 는 게시 대상 아님(maven.deploy.skip)이라 소비자 전이 문제 없음. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- (구조화 JSON 로깅 logstash-logback-encoder, method-logging 용 spring-boot-starter-aspectj 는
             이제 common-platform-starter-web 이 전이로 제공 → 여기서 직접 나열하지 않는다.) -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4: MockMvc 슬라이스 지원이 별도 모듈로 분리됨 (@AutoConfigureMockMvc 제공) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 분산 세션(Redis) 컨벤션 데모: Spring Session + Redis 클라이언트(lettuce).
             Spring Session이 classpath에 있으면 Boot가 세션 저장소를 요구하므로 클라이언트도 함께 둔다 -->
        <!-- compile 스코프로 둬서 (1) demo 프로파일의 세션 케이스가 실제 Redis 에 붙고
             (2) 데모 코드가 StringRedisTemplate 으로 세션 키를 조회할 수 있게 한다.
             비-demo 프로파일은 application.yml 에서 redis health 를 꺼 영향이 없다. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 캐시 추상화 컨벤션 데모: Boot 캐시 자동구성(@EnableCaching + RedisCacheManager).
             라이브러리 CommonCacheAutoConfiguration 이 이 starter 가 있을 때만 활성(@ConditionalOnClass). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- DB 계층 데모 ③ JTA/XA(원자적 다중 DB) — Atomikos 프로그램적 시연용. 데모 한정(라이브러리 미의존).
             ①(라이브러리 라우팅)·②(개별 TxManager)는 H2 만으로 시연하므로 별도 의존성 없음. -->
        <dependency>
            <groupId>com.atomikos</groupId>
            <artifactId>transactions-jdbc</artifactId>
            <version>6.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.atomikos</groupId>
            <artifactId>transactions-jta</artifactId>
            <version>6.0.0</version>
        </dependency>
        <!-- Atomikos 6.0.0 은 javax.transaction.*(JTA 1.3) 네임스페이스를 쓴다(jakarta.transaction-api:1.3.3=provided).
             앱의 jakarta.transaction-api:2.0(JPA용, jakarta.* 패키지)과 좌표가 달라 공존한다 — 데모 XA 한정. -->
        <dependency>
            <groupId>javax.transaction</groupId>
            <artifactId>javax.transaction-api</artifactId>
            <version>1.3</version>
        </dependency>

        <!-- 실연동(PostgreSQL) 감사 검증: Testcontainers. Docker 없으면 테스트가 자동 skip된다 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL JDBC 드라이버: runtime 스코프.
             local 프로파일(application-local.yml)이 실 PostgreSQL 에 붙어 앱으로
             기동되므로 런타임 classpath 에 있어야 한다(F5 [local]). runtime 은
             테스트 classpath 에도 포함되므로 Testcontainers/live 테스트도 그대로 동작. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              jOOQ 코드젠(운영 권장): 라이브 DB 없이 Flyway 마이그레이션(db/migration/*.sql)을 DDLDatabase 로
              파싱해 board 테이블/컬럼을 컴파일타임 타입세이프 코드로 생성한다(target/generated-sources/jooq).
              → BoardJooqDao 가 문자열 DSL.name(...) 대신 생성 상수(BOARD_POST.TITLE 등)를 써 완전 타입안전.
              버전은 spring-boot-starter-parent(=spring-boot-dependencies)의 ${jooq.version} 로 런타임 jOOQ 와 정합.
            -->
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <version>${jooq.version}</version>
                <executions>
                    <execution>
                        <id>generate-board-jooq</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                    </execution>
                </executions>
                <dependencies>
                    <!-- DDLDatabase(마이그레이션 스크립트 → 메타데이터) 제공 -->
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-meta-extensions</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <generator>
                        <database>
                            <name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
                            <properties>
                                <property>
                                    <key>scripts</key>
                                    <value>src/main/resources/db/migration/*.sql</value>
                                </property>
                                <!-- Flyway 버전 순서(V1→V2→V3)대로 적용해 ALTER 까지 반영 -->
                                <property>
                                    <key>sort</key>
                                    <value>flyway</value>
                                </property>
                                <!-- 식별자를 소문자로 파싱 → 렌더 시 "board_post"/"id"(소문자). H2 CASE_INSENSITIVE 와
                                     PostgreSQL(소문자 기본) 양쪽에 이식(기존 동적 DAO 의 DSL.name 소문자 관습과 동일). -->
                                <property>
                                    <key>defaultNameCase</key>
                                    <value>lower</value>
                                </property>
                            </properties>
                            <!-- board 테이블만 생성(감사용 sample_note·flyway 메타테이블 제외) -->
                            <includes>board_.*</includes>
                            <!-- 감사 시각(created_at/updated_at)은 도메인이 Instant 를 쓰므로 TIMESTAMP WITH TIME ZONE
                                 → java.time.Instant 로 강제 매핑(BoardPostRow 와 정합, OffsetDateTime 누출 방지). -->
                            <forcedTypes>
                                <forcedType>
                                    <userType>java.time.Instant</userType>
                                    <converter>org.jooq.Converter.ofNullable(
                                        java.time.OffsetDateTime.class, java.time.Instant.class,
                                        java.time.OffsetDateTime::toInstant,
                                        (java.time.Instant i) -&gt; i.atOffset(java.time.ZoneOffset.UTC))</converter>
                                    <includeExpression>.*\.(created_at|updated_at)</includeExpression>
                                    <includeTypes>.*</includeTypes>
                                </forcedType>
                            </forcedTypes>
                        </database>
                        <generate>
                            <!-- 샘플은 DAO 가 직접 SQL 을 조립하므로 액티브레코드/DAO 는 생성하지 않는다(테이블/필드만). -->
                            <records>false</records>
                            <pojos>false</pojos>
                            <daos>false</daos>
                        </generate>
                        <target>
                            <packageName>ai.mutuus.sample.board.jooq.gen</packageName>
                            <directory>${project.build.directory}/generated-sources/jooq</directory>
                        </target>
                    </generator>
                </configuration>
            </plugin>
            <!-- MapStruct 애노테이션 프로세서(컴파일 타임 매퍼 생성) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 포크된 테스트 JVM 출력을 UTF-8로 고정 — 한글 테스트명/로그가
                 Windows cp949 콘솔에서 깨지지 않도록(빌드 동작엔 영향 없음) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
