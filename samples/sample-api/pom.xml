<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>ai.mutuus.sample</groupId>
    <artifactId>sample-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>sample-api</name>
    <description>common-platform 소비 검증용 샘플 API (통합 테스트)</description>

    <properties>
        <java.version>21</java.version>
        <!-- 샘플은 사내 저장소에 게시하지 않는다 (reactor 의 ./mvnw deploy 시 제외) -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- 검증 대상: 공통 플랫폼 라이브러리 (의존성 하나) -->
        <dependency>
            <groupId>ai.mutuus.common</groupId>
            <artifactId>common-platform</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- 일반 API 서비스가 보유하는 starter들 → 라이브러리의 web/security/actuator 자동구성이 활성화됨 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- @Valid 검증(VALIDATION_ERROR 데모) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 아웃바운드 RestClient 자동구성(헤더 전파 Customizer 활성화 데모) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <!-- 영속성(BaseEntity 감사 데모): JPA + H2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 구조화 JSON 로깅: 라이브러리의 logback-common.xml 이 LogstashEncoder 를 쓴다.
             라이브러리에선 optional 이라 전이되지 않으므로, JSON 로깅을 쓰는 소비자는 직접 추가한다. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 메서드 인자/리턴 로깅(method-logging, AOP)은 라이브러리에선 optional 이라 전이되지 않는다.
             전체 로깅 구간 검증 테스트(LoggingCaseMatrixIntegrationTest)에서만 켜므로 test 스코프로 둔다.
             Boot 4: spring-boot-starter-aop → spring-boot-starter-aspectj. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4: MockMvc 슬라이스 지원이 별도 모듈로 분리됨 (@AutoConfigureMockMvc 제공) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 분산 세션(Redis) 컨벤션 데모: Spring Session + Redis 클라이언트(lettuce).
             Spring Session이 classpath에 있으면 Boot가 세션 저장소를 요구하므로 클라이언트도 함께 둔다 -->
        <!-- compile 스코프로 둬서 (1) demo 프로파일의 세션 케이스가 실제 Redis 에 붙고
             (2) 데모 코드가 StringRedisTemplate 으로 세션 키를 조회할 수 있게 한다.
             비-demo 프로파일은 application.yml 에서 redis health 를 꺼 영향이 없다. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 실연동(PostgreSQL) 감사 검증: Testcontainers. Docker 없으면 테스트가 자동 skip된다 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL JDBC 드라이버: runtime 스코프.
             local 프로파일(application-local.yml)이 실 PostgreSQL 에 붙어 앱으로
             기동되므로 런타임 classpath 에 있어야 한다(F5 [local]). runtime 은
             테스트 classpath 에도 포함되므로 Testcontainers/live 테스트도 그대로 동작. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 포크된 테스트 JVM 출력을 UTF-8로 고정 — 한글 테스트명/로그가
                 Windows cp949 콘솔에서 깨지지 않도록(빌드 동작엔 영향 없음) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
