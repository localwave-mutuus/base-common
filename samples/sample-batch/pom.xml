<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>ai.mutuus.sample</groupId>
    <artifactId>sample-batch</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>sample-batch</name>
    <description>common-platform 비(非)웹 소비 검증용 샘플 — web/security 자동구성 비전이 증명</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- 검증 대상: 공통 플랫폼 라이브러리 (의존성 하나, web/security starter 없음) -->
        <dependency>
            <groupId>ai.mutuus.common</groupId>
            <artifactId>common-platform</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- 비웹 서비스: web/security starter를 의존하지 않는다 → 해당 자동구성은 비활성 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
