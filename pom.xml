<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      집계(aggregator) pom — 게시 대상이 아니다.
      실제 산출물 라이브러리는 lib/ 모듈(ai.mutuus.common:common-platform)이고,
      samples/* 는 그 라이브러리를 의존성 하나로 끌어쓰는 소비 검증용 샘플이다.
      이 reactor 의 목적:
        1) IDE(특히 VS Code/Eclipse jdt.ls)가 라이브러리와 샘플을 한 창에서
           모두 별도 프로젝트로 임포트하게 한다. (라이브러리를 lib/ 하위로 내려
           samples 와 형제로 만들어, Eclipse 의 '프로젝트 위치 중첩 금지' 위반을 피한다.)
        2) reactor 빌드 시 samples 가 lib 를 .m2 의 stale jar 가 아니라 방금 빌드한
           모듈에서 해석하도록 한다(라이브러리 수정 후 재설치 없이 샘플 테스트 가능).
      라이브러리만 설치/게시하려면: ./mvnw -pl lib install  /  ./mvnw -pl lib deploy
      (samples 와 이 aggregator 는 maven.deploy.skip=true 로 게시에서 제외된다.)
    -->
    <groupId>ai.mutuus.common</groupId>
    <artifactId>common-platform-aggregator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>common-platform-aggregator</name>
    <description>common-platform 라이브러리(lib) + 소비 검증 샘플(samples)을 묶는 reactor (게시 대상 아님)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 집계 pom 자체는 사내 저장소에 게시하지 않는다 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!--
      reactor 모듈. Maven 이 의존관계로 빌드 순서를 정렬한다:
      samples 가 ai.mutuus.common:common-platform 을 의존하므로 lib 가 먼저 빌드된다.
    -->
    <modules>
        <module>lib</module>
        <module>samples/sample-api</module>
        <module>samples/sample-batch</module>
    </modules>
</project>
