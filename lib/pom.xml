<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mutuus.common</groupId>
        <artifactId>common-platform-parent</artifactId>
        <version>0.2.0</version>
        <relativePath>../parent/pom.xml</relativePath>
    </parent>

    <groupId>ai.mutuus.common</groupId>
    <artifactId>common-platform</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>
    <name>common-platform</name>
    <description>AI backend common library (telemetry/logging/trace/session/i18n/auth/util)</description>

    <properties>
        <!-- java.version·maven.compiler.release·sourceEncoding·logstash-encoder·spring-modulith 버전은 common-platform-parent 상속 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- core: always required -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- web: trace filter, header propagation, exception handling, locale -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 아웃바운드 추적 헤더 전파 자동등록(RestClient/RestTemplate Customizer).
             Boot 4에서 RestClient 자동구성이 별도 모듈로 분리됨 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- aop: 컨트롤러 메서드 인자/리턴 로깅 Aspect(@Around). optional — 소비자가 켤 때만.
             Boot 4 에서 spring-boot-starter-aop → spring-boot-starter-aspectj 로 아티팩트명이 바뀌었다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- openapi: 공통 OpenAPI(springdoc) 설정 — info + Bearer JWT 보안스킴. optional(소비자가
             springdoc 를 추가할 때만 자동구성이 활성). 버전은 common-platform-parent 의 springdoc.version. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <version>${springdoc.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- security: OAuth2 Resource Server (JWT) auth integration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- observability: actuator + Micrometer Tracing (OTel) + Prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- structured logging (JSON) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-encoder.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Spring Modulith observability (2.x: 단일 jar이 -api/-core로 분리됨; -core가 -api를 전이로 포함) -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-observability-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- distributed session (optional): Redis -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- cache (optional): Redis CacheManager 컨벤션. spring-data-redis 의 RedisCacheManager/
             RedisCacheConfiguration/직렬화를 컴파일 참조하기 위해 둔다. 소비자는 Boot 캐시 자동구성을
             위해 spring-boot-starter-cache 를 함께 추가해야 캐시가 실제 활성(@ConditionalOnClass 로 가드). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- persistence (optional): JPA 공통 베이스 엔티티 + 감사 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 게시 좌표(distributionManagement)·배포 정책(deployAtEnd)은 common-platform-parent 에서 상속한다. -->
</project>
