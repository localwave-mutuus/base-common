<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <!--
      common-platform 게시 모듈(bom·lib·starters)의 공용 부모.
      게시 좌표(distributionManagement)·배포 정책(deployAtEnd)·공통 버전을 한 곳에서 관리 →
      자식 모듈에 복붙되던 설정 중복을 제거한다(단일 출처).
      소비자가 lib/starter 의 pom 을 해석할 때 이 parent 도 필요하므로, parent 도 게시 대상이다.
    -->
    <groupId>ai.mutuus.common</groupId>
    <artifactId>common-platform-parent</artifactId>
    <version>0.2.1</version>
    <packaging>pom</packaging>
    <name>common-platform-parent</name>
    <description>common-platform 게시 모듈 공용 부모 — 게시 좌표·배포 정책·공통 버전 단일 관리</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 라이브러리가 노출하는 optional 3rd-party 버전(소비자 BOM 과 동일 출처) -->
        <logstash-encoder.version>8.0</logstash-encoder.version>
        <springdoc.version>3.0.3</springdoc.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
    </properties>

    <build>
        <plugins>
            <!--
              게시 모듈 전체를 리액터(=샘플 테스트 포함)가 모두 성공한 뒤에만 일괄 업로드한다.
              기본 동작(모듈별 빌드 직후 업로드)이면 게시 모듈(bom→lib→starters)이 샘플 테스트보다
              먼저 올라가 "테스트 실패인데 lib 는 이미 배포된" 부분 배포가 난다. deployAtEnd 로 원자화 →
              `./mvnw clean deploy` 한 방으로 "테스트 후 배포"가 안전하게 성립한다.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <deployAtEnd>true</deployAtEnd>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 게시 대상: 사내 Nexus. 자식(bom·lib·starters)이 상속 → 한 곳만 관리.
         버전이 -SNAPSHOT 이면 maven-snapshots, 정식이면 maven-releases 로 Maven 이 자동 라우팅.
         자격은 ~/.m2/settings.xml 의 <server> id(nexus-releases/nexus-snapshots, deployer)와 매칭. -->
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus Releases</name>
            <url>https://nexusrepo.local/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>Nexus Snapshots</name>
            <url>https://nexusrepo.local/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
